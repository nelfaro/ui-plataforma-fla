# Variables del gateway (se configuran en EasyPanel -> servicio -> Entorno). NO subir valores reales.
# Generar secretos:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_USER=fla
ADMIN_PASSWORD=
N8N_BASE_URL=https://agente-fla-n8n.x5miqk.easypanel.host
# Mismo valor que la credencial "Header Auth" (nombre de cabecera: x-api-key) creada en n8n
N8N_API_KEY=
SESSION_HOURS=8

    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input.query || {};\nconst { whatsapp, mensaje, tipo, direccion, tipo_media, lead_tipo, intencion } = body;\n\nif (!whatsapp || !mensaje) {\n  throw new Error('Faltan campos requeridos: whatsapp, mensaje');\n}\n\nconst mensaje_preview = String(mensaje).substring(0, 50);\nconst msg = String(mensaje).replace(/'/g, \"''\");\n\nconst query = `INSERT INTO conversation_log (whatsapp, mensaje, tipo, direccion, tipo_media, mensaje_preview, lead_tipo, intencion, created_at)\nVALUES ('${whatsapp}', '${msg}', '${tipo || 'mensaje'}', '${direccion || 'entrada'}', '${tipo_media || 'texto'}', '${mensaje_preview}', ${lead_tipo ? `'${lead_tipo}'` : 'null'}, ${intencion ? `'${intencion}'` : 'null'}, CURRENT_TIMESTAMP)\nRETURNING id, whatsapp, created_at;`;\n\nreturn [{json: {query}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "12d35628-a90b-4612-a7ae-7e3515d9f749",

    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst query = input.query || {};\nconst { whatsapp, limit = 50, offset = 0 } = query;\n\nif (!whatsapp) {\n  throw new Error('Parámetro requerido: whatsapp');\n}\n\nconst sqlQuery = `SELECT id, whatsapp, mensaje, tipo, direccion, tipo_media, mensaje_preview, lead_tipo, intencion, created_at\nFROM conversation_log\nWHERE whatsapp = '${whatsapp}'\nORDER BY created_at DESC\nLIMIT ${parseInt(limit)} OFFSET ${parseInt(offset)};`;\n\nreturn [{json: {sqlQuery}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "cd0497b2-eeb1-4267-8268-2cfc0c3374cd",
      "name": "Build Query"
    },
    {
      "parameters": {
        "jsCode": "const result = $('postgres_node').all();\nreturn [{json: {success: true, messages: result.map(r => r.json), count: result.length}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

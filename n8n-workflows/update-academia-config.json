    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\n\nconst fields = [\n  'nombre_academia', 'nombre_profe', 'email', 'telefono',\n  'ubicacion_direccion', 'ubicacion_localidad', 'horario_atencion',\n  'banco', 'cbu', 'alias', 'linktree_url',\n  'instagram', 'facebook', 'politica_cancelacion',\n  'politica_recuperacion', 'politica_reembolso'\n];\n\nconst values = [];\nlet hasUpdates = false;\n\nfor (const field of fields) {\n  const value = body[field];\n  if (value !== undefined && value !== null && value !== '') {\n    const escaped = String(value).replace(/'/g, \"''\");\n    values.push(`('${field}', '${escaped}', NOW())`);\n    hasUpdates = true;\n  }\n}\n\nlet query = null;\nif (hasUpdates) {\n  query = `INSERT INTO academia_config (clave, valor, updated_at) \nVALUES ${values.join(', ')} \nON CONFLICT (clave) DO UPDATE SET valor = EXCLUDED.valor, updated_at = NOW()\nRETURNING clave, valor;`;\n}\n\nreturn [{\n  json: {\n    query,\n    hasUpdates,\n    values\n  }\n}];"
      },

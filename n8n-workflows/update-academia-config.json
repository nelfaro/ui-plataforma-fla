    {
      "parameters": {
        "jsCode": "const results = $input.all();\nconst config = {};\n\nfor (const row of results) {\n  const data = row.json;\n  if (data.clave && data.valor !== undefined) {\n    config[data.clave] = data.valor;\n  }\n}\n\nreturn [{\n  json: {\n    success: true,\n    message: 'Configuración actualizada exitosamente',\n    config\n  }\n}];"
      },
      "id": "906eefd6-bef7-4318-ab0a-41051ea1108c",

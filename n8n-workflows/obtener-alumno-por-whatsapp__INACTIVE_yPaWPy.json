    {
      "parameters": {
        "jsCode": "const alumnoData = $('Get alumno').first()?.json;\nconst inscripcionesData = $('Get inscripciones').all().map(row => row.json);\nconst pagosData = $('Get pagos').all().map(row => row.json);\n\nlet response = {\n  success: false,\n  alumno: null,\n  inscripciones: [],\n  pagos_recientes: []\n};\n\nif (alumnoData) {\n  response.success = true;\n  response.alumno = alumnoData;\n  response.inscripciones = inscripcionesData;\n  response.pagos_recientes = pagosData;\n}\n\nreturn [{ json: response }];"
      },

    {
      "parameters": {
        "jsCode": "const whatsapp = $input.first()?.json?.whatsapp;\n\nif (!whatsapp) {\n  throw new Error('whatsapp es requerido');\n}\n\nconst queries = {\n  alumno: `SELECT id, whatsapp, nombre, estado, tags, email, nivel, objetivo, disponibilidad, notas, kids_nombre, kids_edad, kids_colegio, kids_turno, kids_grado, referencia, lead_tipo, origen, intencion, completitud, resumen, estado_pago, fecha_pago_ultimo, foto_url, fecha_registro, created_at, updated_at FROM alumnos WHERE whatsapp = '${whatsapp}'`,\n  inscripciones: `SELECT i.id, i.horario_id, h.nombre as horario_nombre, i.estado, i.fecha_inicio, i.fecha_fin FROM inscripciones i LEFT JOIN horarios h ON i.horario_id = h.id WHERE i.alumno_id = (SELECT id FROM alumnos WHERE whatsapp = '${whatsapp}') AND i.estado = 'ACTIVA'`,\n  pagos: `SELECT id, tipo, canal, monto, estado, fecha FROM pagos WHERE alumno_id = (SELECT id FROM alumnos WHERE whatsapp = '${whatsapp}') ORDER BY fecha DESC LIMIT 3`\n};\n\nreturn [{\n  json: { queries, whatsapp }\n}];"
      },
      "type": "n8n-nodes-base.code",

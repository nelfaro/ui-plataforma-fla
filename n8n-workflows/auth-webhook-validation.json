    {
      "parameters": {
        "jsCode": "const headers = $input.first().json.headers || {};\nconst apiKey = headers['x-api-key'];\n\n// Extraer IP real (está en x-forwarded-for)\nconst xForwardedFor = headers['x-forwarded-for'];\nconst ipOrigen = xForwardedFor ? xForwardedFor.split(',')[0].trim() : 'unknown';\n\nconst API_KEY_VALIDA = 'fla-2026-Clas3sd31ngl3s';\n\nreturn [{\n  json: {\n    apiKey: apiKey,\n    ipOrigen: ipOrigen,\n    valido: apiKey === API_KEY_VALIDA\n  }\n}];"
      },

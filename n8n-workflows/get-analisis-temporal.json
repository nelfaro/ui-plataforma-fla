      "parameters": {
        "jsCode": "const nuevosArr = $('nuevos').all().map(row => row.json);\nconst conversionArr = $('conversion').all().map(row => row.json).slice(0, nuevosArr.length);\nconst ingresosArr = $('ingresos').all().map(row => row.json);\n\nreturn [{\n  json: {\n    items: {\n      nuevos_por_semana: nuevosArr,\n      conversion_por_semana: conversionArr,\n      ingresos_acumulados: ingresosArr\n    }\n  }\n}];"

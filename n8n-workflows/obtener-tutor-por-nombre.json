        "jsCode": "const resultados = $('buscar tutores').all();\nconst tutores = resultados.map(r => r.json);\n\nreturn [{\n  json: {\n    success: true,\n    cantidad: tutores.length,\n    resultados: tutores\n  }\n}];"

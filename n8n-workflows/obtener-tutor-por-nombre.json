    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst nombre = (input.nombre || '').trim();\n\nif (!nombre || nombre.length < 2) {\n  return [{\n    json: {\n      success: false,\n      message: 'Nombre debe tener al menos 2 caracteres',\n      resultados: []\n    }\n  }];\n}\n\nconst query = `SELECT t.id, t.nombre, t.whatsapp, t.email, t.relacion, \n       a.id as alumno_id, a.nombre as alumno_nombre, a.categoria\nFROM tutores t\nLEFT JOIN alumnos a ON t.alumno_id = a.id\nWHERE t.nombre ILIKE '%${nombre.replace(/'/g, \"''\")}%' \nAND t.activo = TRUE\nORDER BY t.nombre ASC\nLIMIT 10;`;\n\nreturn [{\n  json: { query }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        544
      ],
      "id": "9ac8d42b-0695-4059-b78d-4493a78cd33a",
      "name": "arma query"
    },

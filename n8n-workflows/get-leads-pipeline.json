    {
      "parameters": {
        "jsCode": "const listData = $('PostgreSQL - List').all();\nconst countData = $('PostgreSQL - Count').all();\nconst total = countData[0]?.json?.total || 0;\nconst items = listData.map(row => row.json);\n\nreturn [{\n  json: {\n    success: true,\n    items: items,\n    total: parseInt(total),\n    count: items.length\n  }\n}];"
      },

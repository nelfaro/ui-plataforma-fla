    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst bodyData = input.body || {};\nconst { nombre, tipo, nivel, categoria, dia_1, dia_2, hora_inicio, hora_fin, cupo_max, precio_mensual, descripcion } = bodyData;\n\nif (!nombre || !tipo || !nivel || !categoria || !dia_1 || !dia_2 || !hora_inicio || !hora_fin || !cupo_max) {\n  throw new Error(`Faltan campos requeridos. Recibido: ${JSON.stringify(bodyData)}`);\n}\n\nconst query = `INSERT INTO horarios (nombre, tipo, nivel, categoria, dia_1, dia_2, hora_inicio, hora_fin, cupo_maximo, cupo_actual, precio_mensual, descripcion, activo)\nVALUES ('${nombre.replace(/'/g, \"''\")}', '${tipo}', '${nivel}', '${categoria}', '${dia_1}', '${dia_2}', '${hora_inicio}'::time, '${hora_fin}'::time, ${parseInt(cupo_max)}, 0, ${precio_mensual ? parseFloat(precio_mensual) : 'null'}, ${descripcion ? `'${descripcion.replace(/'/g, \"''\")}'` : 'null'}, TRUE)\nRETURNING id, nombre, tipo, nivel, categoria, dia_1, dia_2, hora_inicio, hora_fin, cupo_max, activo;`;\n\nreturn [{\n  json: {\n    query\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        208
      ],
      "id": "52a351c9-fc71-46df-841f-20fa02bc7c2c",
      "name": "arma query"
    },
    {
      "parameters": {
        "jsCode": "const horario = $('arma query').first().json;\n\nreturn [{\n  json: {\n    success: true,\n    mensaje: 'Horario creado correctamente',\n    horario\n  }\n}];"
      },

    {
      "parameters": {
        "jsCode": "// Si ya tiene success (viene del IF con error de validación)\nif ('success' in $json && !$json.success) {\n  return [$json];\n}\n\n// Si viene del PostgreSQL (éxito en la validación)\nconst alumnos = $('obtener alumno').all();\n\nif (alumnos.length === 0) {\n  return [{\n    json: {\n      success: false,\n      message: 'Alumno no encontrado',\n      alumno: null\n    }\n  }];\n}\n\nconst alumno = alumnos[0].json;\n\nreturn [{\n  json: {\n    success: true,\n    alumno: alumno\n  }\n}];\n"
      },

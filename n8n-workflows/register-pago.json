    {
      "parameters": {
        "jsCode": "const pagoCrud = $('Insert Pago').first().json;\n\nreturn [{\n  json: {\n    success: true,\n    mensaje: 'Pago registrado correctamente',\n    pago_id: pagoCrud.id,\n    alumno_id: pagoCrud.alumno_id\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        224
      ],
      "id": "5bbe821a-53e7-44ba-b8d1-01b2285c2839",
      "name": "respuesta"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst bodyData = input.body || {};\nconst { alumno_id, monto, fecha_pago, tipo_pago, metodo, nota, registrado_por } = bodyData;\n\nconsole.log('Body Data:', JSON.stringify(bodyData));\n\nif (!alumno_id || !monto || !fecha_pago || !tipo_pago) {\n  throw new Error(`Faltan campos. Recibido: ${JSON.stringify(bodyData)}`);\n}\n\nif (monto <= 0) {\n  throw new Error('El monto debe ser mayor a 0');\n}\n\nlet queryPago = '';\n\n// Si es pago MANUAL\nif (tipo_pago === 'MANUAL') {\n  queryPago = `INSERT INTO pagos_manuales (alumno_id, monto, fecha_pago, metodo, nota, registrado_por)\nVALUES (${parseInt(alumno_id)}, ${parseFloat(monto)}, '${fecha_pago}', '${metodo || 'EFECTIVO'}', ${nota ? `'${nota.replace(/'/g, \"''\")}'` : 'null'}, ${registrado_por ? `'${registrado_por}'` : 'null'})\nRETURNING id, alumno_id, monto, fecha_pago;`;\n}\n// Si es pago MERCADO PAGO\nelse if (tipo_pago === 'MERCADO_PAGO') {\n  queryPago = `INSERT INTO pagos (alumno_id, tipo, canal, monto, moneda, periodo, estado, comprobante_fecha)\nVALUES (${parseInt(alumno_id)}, 'CUOTA_MENSUAL', 'MERCADOPAGO', ${parseFloat(monto)}, 'ARS', 'JULIO', 'VERIFICADO', '${fecha_pago}')\nRETURNING id, alumno_id, monto, comprobante_fecha;`;\n}\n\nif (!queryPago) {\n  throw new Error(`tipo_pago inválido: \"${tipo_pago}\"`);\n}\n\n// Query 2: UPDATE en tabla alumnos\nconst queryAlumno = `UPDATE alumnos\nSET estado_pago = 'PAGADO',\n    fecha_pago_ultimo = '${fecha_pago}',\n    updated_at = NOW()\nWHERE id = ${parseInt(alumno_id)}\nRETURNING id, estado_pago, fecha_pago_ultimo;`;\n\nreturn [{\n  json: { queryPago, queryAlumno, alumno_id, tipo_pago }\n}];\n"
      },

        "jsCode": "const input = $input.first().json;\nconst query = input.query || input.body || {};\nconst { id } = query;\n\nif (!id) {\n  throw new Error('Falta el parámetro requerido: id');\n}\n\nconst sqlQuery = `SELECT id, nombre, apellido, whatsapp, email, telefono, lead_tipo, origen, categoria, nivel, objetivo, resumen, disponibilidad, tags, estado, estado_motivo, estado_fecha, primer_contacto, ultimo_contacto, proxima_cita, alumno_id, fecha_conversion, notas, created_at, updated_at FROM leads WHERE id = ${parseInt(id)};`;\n\nreturn [{json: {sqlQuery}}];"
      },

    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst nombre = (input.nombre || '').trim();\n\nif (!nombre || nombre.length < 2) {\n  return [{\n    json: {\n      success: false,\n      message: 'Nombre debe tener al menos 2 caracteres',\n      resultados: []\n    }\n  }];\n}\n\nconst query = `SELECT id, nombre, apellido, email, whatsapp, categoria, estado, activo, created_at\nFROM alumnos\nWHERE nombre ILIKE '%${nombre.replace(/'/g, \"''\")}%' \nAND activo = TRUE\nORDER BY nombre ASC\nLIMIT 10;`;\n\nreturn [{\n  json: { query }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        576
      ],
      "id": "68b1d665-2346-40fc-b2a6-a8c7eb7eb2a6",
      "name": "arma query"
    },

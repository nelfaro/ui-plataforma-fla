    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    COALESCE(SUM(CASE WHEN estado IN ('REGISTRADO', 'ACTIVO') THEN 1 ELSE 0 END), 0)::integer as registrados,\n    COALESCE(SUM(CASE WHEN estado = 'CALIFICADO' THEN 1 ELSE 0 END), 0)::integer as leads_calificados,\n    COALESCE(SUM(CASE WHEN DATE(ultimo_contacto) >= '{{ $json.query.startDate }}'::date AND DATE(ultimo_contacto) <= '{{ $json.query.endDate }}'::date THEN 1 ELSE 0 END), 0)::integer as leads_nuevos_mes,\n    0.0::numeric as tasa_conversion_pct,\n    0::integer as ingresos_mes\nFROM alumnos\nWHERE DATE(ultimo_contacto) >= '{{ $json.query.startDate }}'::date\nAND DATE(ultimo_contacto) <= '{{ $json.query.endDate }}'::date",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        160,
        160
      ],
      "id": "6aa4d123-31ea-4b56-a187-926e0267193e",

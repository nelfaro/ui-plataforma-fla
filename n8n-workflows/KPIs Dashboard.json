          "id": "wPNcwJLWeQKZlTmC",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $('Execute a SQL query').first().json;\nreturn [\n  {\n    json: {\n      registrados: parseInt(data.registrados) || 0,\n      leads_calificados: parseInt(data.leads_calificados) || 0,\n      leads_nuevos_mes: parseInt(data.leads_nuevos_mes) || 0,\n      tasa_conversion_pct: parseFloat(data.tasa_conversion_pct) || 0,\n      ingresos_mes: parseInt(data.ingresos_mes) || 0\n    }\n  }\n];"
      },

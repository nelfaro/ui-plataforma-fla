    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH monthly_funnel AS (\n  SELECT\n    a.origen,\n    CASE\n      WHEN a.estado = 'REGISTRADO' THEN 'Registrados'\n      WHEN a.estado = 'ACTIVO' THEN 'Activos'\n      WHEN a.estado = 'PAUSADO' THEN 'Pausados'\n      WHEN a.estado = 'BAJA' THEN 'Baja'\n      ELSE 'Otros'\n    END as etapa,\n    COUNT(DISTINCT a.id)::integer as cantidad\n  FROM alumnos a\n  WHERE\n    DATE(a.fecha_registro) >= '{{ $json.query.startDate }}'::date\n    AND DATE(a.fecha_registro) <= '{{ $json.query.endDate }}'::date\n  GROUP BY a.origen, etapa\n)\nSELECT\n  origen,\n  JSON_OBJECT_AGG(etapa, cantidad) as etapas\nFROM monthly_funnel\nGROUP BY origen\nORDER BY origen;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        0
      ],
      "id": "d64d3a94-37b3-4799-b673-6987be7d9b8f",
      "name": "Query Database",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "wPNcwJLWeQKZlTmC",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const allRows = $('Query Database').all();\n\nconst funnelByOrigin = allRows.map(row => {\n  const etapas = row.json.etapas || {};\n  return {\n    origin: row.json.origen === 'RECOMENDACION' ? 'Recomendación' : 'Orgánico',\n    nuevos: etapas.Nuevos || 0,\n    nutriendo: etapas.Nutriendo || 0,\n    conversion: etapas.Conversión || 0,\n    tasa_conversion: etapas.Nuevos > 0 ? Math.round((etapas.Conversión || 0) / etapas.Nuevos * 100) : 0\n  };\n});\n\nreturn [{\n  json: {\n    items: funnelByOrigin\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",

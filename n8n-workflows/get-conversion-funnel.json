      "id": "3d372e32-c5b7-44b6-916f-3931c6147fd5",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH funnel AS (\n    SELECT 'NUEVO' as etapa, COUNT(DISTINCT id)::integer as cantidad, 1 as orden FROM leads WHERE estado = 'NUEVO'\n    UNION ALL\n    SELECT 'FRIO', COUNT(DISTINCT id)::integer, 2 FROM leads WHERE estado = 'FRIO'\n    UNION ALL\n    SELECT 'TIBIO', COUNT(DISTINCT id)::integer, 3 FROM leads WHERE estado = 'TIBIO'\n    UNION ALL\n    SELECT 'CALIENTE', COUNT(DISTINCT id)::integer, 4 FROM leads WHERE estado = 'CALIENTE'\n)\nSELECT etapa, cantidad FROM funnel ORDER BY orden;",
        "options": {}
      },

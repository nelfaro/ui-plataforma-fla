    {
      "parameters": {
        "jsCode": "const allRows = $('obtener datos').all();\n\nreturn [{\n  json: {\n    items: allRows.map(row => ({\n      etapa: row.json.etapa,\n      cantidad: parseInt(row.json.cantidad) || 0\n    }))\n  }\n}];"
      },

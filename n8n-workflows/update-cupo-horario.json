    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst bodyData = input.body || {};\nconst { horario_id, accion } = bodyData;\n\nif (!horario_id || !accion) {\n  throw new Error('horario_id y accion son requeridos');\n}\n\n// accion puede ser 'incrementar' o 'decrementar'\nconst operador = accion === 'decrementar' ? '-' : '+';\n\nconst query = `UPDATE horarios\nSET cupo_actual = cupo_actual ${operador} 1,\n    updated_at = NOW()\nWHERE id = ${parseInt(horario_id)}\nRETURNING id, cupo_actual, cupo_max;`;\n\nreturn [{\n  json: {\n    query\n  }\n}];"
      },

        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $('obtener datos').all();\nreturn data.map(row => ({\n  json: {\n    name: row.json.name || 'Sin datos',\n    chats: parseInt(row.json.chats) || 0,\n    registros: parseInt(row.json.registros) || 0\n  }\n}));"

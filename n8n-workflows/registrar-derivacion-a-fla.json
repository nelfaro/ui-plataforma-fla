    },
    {
      "parameters": {
        "jsCode": "const resultados = $('actualizar estado').all();\n\nif (resultados.length === 0) {\n  return [{\n    json: {\n      success: false,\n      message: 'Alumno no encontrado o no activo',\n      alumno_id: $('arma query').first().json.alumno_id\n    }\n  }];\n}\n\nconst alumno = resultados[0].json;\n\nreturn [{\n  json: {\n    success: true,\n    message: `Alumno ${alumno.nombre} (ID: ${alumno.id}) derivado a Fla`,\n    alumno_id: alumno.id,\n    alumno_nombre: alumno.nombre,\n    nuevo_estado: alumno.estado,\n    actualizado_en: alumno.updated_at\n  }\n}];"
      },

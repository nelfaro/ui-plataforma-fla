    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst alumno_id = input.alumno_id || input.id;\nconst tipo = (input.tipo || 'alumno').toLowerCase();\n\nif (!alumno_id || (typeof alumno_id !== 'number' && isNaN(Number(alumno_id)))) {\n  return [{\n    json: {\n      success: false,\n      message: 'alumno_id requerido y debe ser número',\n      alumno_id: null\n    }\n  }];\n}\n\nif (!['alumno', 'tutor'].includes(tipo)) {\n  return [{\n    json: {\n      success: false,\n      message: 'tipo debe ser alumno o tutor',\n      tipo: tipo\n    }\n  }];\n}\n\nconst idNum = Number(alumno_id);\nconst query = `UPDATE alumnos \nSET estado = 'DERIVADO_A_FLA', \n    updated_at = NOW()\nWHERE id = ${idNum} AND activo = TRUE\nRETURNING id, nombre, estado, updated_at;`;\n\nreturn [{\n  json: { query, alumno_id: idNum, tipo }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,

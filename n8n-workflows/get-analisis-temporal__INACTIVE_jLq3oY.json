    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst query = input.query || {};\nconst { startDate, endDate } = query;\n\nconst start = startDate || '2026-01-01';\nconst end = endDate || '2026-04-23';\n\nconst queryNuevos = `WITH semanas AS (\n  SELECT generate_series(\n    DATE_TRUNC('week', '${start}'::date),\n    DATE_TRUNC('week', '${end}'::date),\n    '1 week'::interval\n  )::date as semana_inicio\n)\nSELECT \n  TO_CHAR(s.semana_inicio, 'YYYY-WW') as semana,\n  COUNT(a.id)::integer as nuevos\nFROM semanas s\nLEFT JOIN alumnos a ON DATE_TRUNC('week', a.fecha_registro) = s.semana_inicio\nGROUP BY s.semana_inicio\nORDER BY s.semana_inicio ASC;`;\n\nconst queryConversion = `WITH semanas AS (\n  SELECT generate_series(\n    DATE_TRUNC('week', '${start}'::date),\n    DATE_TRUNC('week', '${end}'::date),\n    '1 week'::interval\n  )::date as semana_inicio\n)\nSELECT \n  TO_CHAR(s.semana_inicio, 'YYYY-WW') as semana,\n  ROUND(100.0 * COUNT(CASE WHEN a.estado IN ('REGISTRADO', 'ACTIVO') THEN 1 END) / \n    NULLIF(COUNT(a.id), 0), 1)::integer as conversion\nFROM semanas s\nLEFT JOIN alumnos a ON DATE_TRUNC('week', a.fecha_registro) = s.semana_inicio\nGROUP BY s.semana_inicio\nORDER BY s.semana_inicio ASC;`;\n\nconst queryIngresos = `SELECT \n  TO_CHAR(DATE_TRUNC('month', p.fecha_pago), 'YYYY-MM') as mes,\n  COALESCE(SUM(p.monto), 0)::decimal as ingresos\nFROM pagos_manuales p\nWHERE p.fecha_pago BETWEEN '${start}'::date AND '${end}'::date\nGROUP BY DATE_TRUNC('month', p.fecha_pago)\nORDER BY mes ASC;`;\n\nreturn [{\n  json: {\n    queryNuevos,\n    queryConversion,\n    queryIngresos\n  }\n}];"
      },

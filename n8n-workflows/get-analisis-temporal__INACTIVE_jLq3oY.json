        "jsCode": "const nuevos = $('nuevos').all().map(row => row.json);\nconst conversion = $('conversion').all().map(row => row.json);\nconst ingresos = $('ingresos').all().map(row => row.json);\n\nreturn [{\n  json: {\n    items: {\n      nuevos_por_semana: nuevos,\n      conversion_por_semana: conversion,\n      ingresos_acumulados: ingresos\n    }\n  }\n}];"

      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "wPNcwJLWeQKZlTmC",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst config = {};\n\nfor (const row of rows) {\n  const data = row.json;\n  if (data.clave && data.valor !== undefined) {\n    config[data.clave] = data.valor || '';\n  }\n}\n\nconst fields = [\n  'nombre_academia', 'nombre_profe', 'email', 'telefono',\n  'ubicacion_direccion', 'ubicacion_localidad', 'horario_atencion',\n  'banco', 'cbu', 'alias', 'linktree_url',\n  'instagram', 'facebook', 'politica_cancelacion',\n  'politica_recuperacion', 'politica_reembolso'\n];\n\nconst resultado = {};\nfor (const field of fields) {\n  resultado[field] = config[field] || '';\n}\n\nreturn [{\n  json: {\n    config: resultado\n  }\n}];"
      },

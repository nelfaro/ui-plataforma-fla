    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT clave, valor FROM academia_config WHERE clave IN ('nombre_academia', 'nombre_profe', 'email', 'telefono', 'ubicacion_direccion', 'ubicacion_localidad', 'horario_atencion', 'banco', 'cbu', 'alias', 'linktree_url', 'instagram', 'facebook', 'politica_cancelacion', 'politica_recuperacion', 'politica_reembolso');",
        "options": {}
      },

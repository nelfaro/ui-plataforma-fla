    {
      "parameters": {
        "jsCode": "const resultado = $('Query DB').all();\nconst action = $('Build Query').first().json._action;\n\nif (action === 'delete') {\n  return [{\n    json: {\n      success: true,\n      message: 'Item eliminado correctamente',\n      item: null\n    }\n  }];\n}\n\nconst item = resultado[0]?.json || null;\n\nreturn [{\n  json: {\n    success: true,\n    message: `Item ${action === 'create' ? 'creado' : 'actualizado'} correctamente`,\n    item\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        48
      ],
      "id": "6ec2faab-2136-492e-9aef-7e68bc298617",
      "name": "Response"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst data = input.body || input;\nconst { id, categoria, segmento, titulo, contenido, _action } = data;\n\nif (!_action) {\n  throw new Error('_action es requerido (create, update, delete)');\n}\n\nif (_action === 'delete' && !id) {\n  throw new Error('id es requerido para delete');\n}\n\nif (_action !== 'delete' && (!categoria || !segmento || !titulo || !contenido)) {\n  throw new Error('categoria, segmento, titulo y contenido son requeridos');\n}\n\nlet query = '';\nconst cat = String(categoria).replace(/'/g, \"''\");\nconst seg = String(segmento).replace(/'/g, \"''\");\nconst tit = String(titulo).replace(/'/g, \"''\");\nconst cont = String(contenido).replace(/'/g, \"''\");\n\nif (_action === 'create') {\n  query = `INSERT INTO conocimiento_academia (categoria, segmento, titulo, contenido, activo) VALUES ('${cat}', '${seg}', '${tit}', '${cont}', true) RETURNING id, categoria, segmento, titulo, contenido, activo;`;\n}\nelse if (_action === 'update') {\n  if (!id) throw new Error('id es requerido para update');\n  query = `UPDATE conocimiento_academia SET categoria = '${cat}', segmento = '${seg}', titulo = '${tit}', contenido = '${cont}' WHERE id = ${parseInt(id)} RETURNING id, categoria, segmento, titulo, contenido, activo;`;\n}\nelse if (_action === 'delete') {\n  if (!id) throw new Error('id es requerido para delete');\n  query = `DELETE FROM conocimiento_academia WHERE id = ${parseInt(id)} RETURNING id;`;\n}\n\nreturn [{\n  json: {\n    query,\n    _action\n  }\n}];"
      },
